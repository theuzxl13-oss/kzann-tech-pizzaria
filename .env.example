# ───────── Kzann Tech Pizzaria — variáveis de ambiente ─────────
# Copie para .env e ajuste. NUNCA versione o .env real.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# URL pública da plataforma (usada em links do cardápio, webhooks e cookies "secure")
PUBLIC_BASE_URL=https://pedidos.seudominio.com.br

# Conexão da APLICAÇÃO — papel SEM superuser e SEM BYPASSRLS (o RLS precisa valer)
DATABASE_URL=postgres://kzann_app:SENHA_FORTE@db-host:5432/kzann
# Conexão usada SÓ nas migrações (dono do schema). Se omitida, usa DATABASE_URL.
MIGRATION_DATABASE_URL=postgres://kzann_owner:OUTRA_SENHA@db-host:5432/kzann
# Papel que recebe GRANTs após as migrações
DB_APP_ROLE=kzann_app
# true para exigir TLS na conexão com o banco (recomendado em produção gerenciada)
DB_SSL=false
# Aplica migrações automaticamente ao iniciar (true/false)
MIGRATE_ON_START=true

# Chave AES-256-GCM para criptografar credenciais de gateway (32 bytes em base64)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Duração da sessão do painel (horas)
SESSION_TTL_HOURS=336

# Cadastro de novas pizzarias: open | code | closed
SIGNUP_MODE=code
SIGNUP_CODE=troque-este-codigo

# Onde salvar imagens enviadas (logo, capa, produtos) — use volume persistente
UPLOAD_DIR=/data/uploads
# Frontend compilado servido pelo backend
WEB_DIST_DIR=../web/dist

# true quando atrás de proxy reverso/balanceador (Nginx, Render, Railway, Fly…)
TRUST_PROXY=true

# Mercado Pago (Pix online). Credenciais são cadastradas POR PIZZARIA no painel.
MERCADOPAGO_API_URL=https://api.mercadopago.com
PIX_EXPIRATION_MINUTES=30
