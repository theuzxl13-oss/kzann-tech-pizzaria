{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:server"],
      "env": { "PORT": "3100" },
      "port": 3100
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:web"],
      "env": { "KZ_API_URL": "http://localhost:3100" },
      "port": 5173
    },
    {
      "name": "demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:demo", "-w", "web"],
      "port": 5174
    }
  ]
}
